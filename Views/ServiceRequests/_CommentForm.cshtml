<div class="card mt-4 mb-4 shadow-sm border-0">
    <div class="card-body bg-light">
        <h5 class="card-title mb-3">Add a Reply</h5>
        <form id="commentForm">
            <div class="mb-3">
                <textarea class="form-control" id="commentBody" rows="3" placeholder="Type your reply here..." required></textarea>
            </div>
            
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Technician"))
                    {
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isInternalNote">
                            <label class="form-check-label text-muted" for="isInternalNote">Mark as internal note</label>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-primary px-4" id="submitCommentBtn">
                    <span class="spinner-border spinner-border-sm d-none me-2" id="commentSpinner" role="status" aria-hidden="true"></span>
                    <i class="bi bi-send-fill me-1" id="commentIcon"></i> Post Reply
                </button>
            </div>
        </form>
    </div>
</div>
