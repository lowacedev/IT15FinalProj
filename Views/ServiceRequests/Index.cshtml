@model List<ITSMS.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<style>
    .details-container {
        background: #f8f9fa;
        min-height: 100vh;
        padding-bottom: 2rem;
    }

    .details-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .details-header-content h1 {
        font-weight: 700;
        margin-bottom: 0;
        font-size: 2rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .details-header-content i {
        font-size: 2.5rem;
    }

    .new-request-btn {
        white-space: nowrap;
    }

    .details-table-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .table-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1.25rem 1.5rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .table-header i {
        font-size: 1.25rem;
    }

    .result-count {
        font-size: 0.875rem;
        opacity: 0.9;
    }

    .details-table {
        margin-bottom: 0;
        font-size: 0.9rem;
    }

    .details-table thead {
        background: #f3f4f6;
        border-bottom: 2px solid #e5e7eb;
    }

    .details-table thead th {
        font-weight: 600;
        color: #374151;
        padding: 1rem;
        border: none;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .details-table tbody tr {
        border-bottom: 1px solid #e5e7eb;
        transition: all 0.3s ease;
    }

    .details-table tbody tr:hover {
        background: #f9fafb;
    }

    .details-table tbody td {
        padding: 1rem;
        vertical-align: middle;
    }

    .request-link {
        font-weight: 600;
        color: #667eea;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .request-link:hover {
        color: #764ba2;
        text-decoration: underline;
    }

    .priority-badge {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    .priority-low {
        color: #0369a1;
    }

    .priority-medium {
        color: #92400e;
    }

    .priority-high {
        color: #9a3412;
    }

    .priority-critical {
        color: #991b1b;
    }

    .status-badge {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    .status-pending {
        color: #92400e;
    }

    .status-inprogress {
        color: #1e40af;
    }

    .status-resolved {
        color: #166534;
    }

    .status-closed {
        color: #374151;
    }

    .small-text {
        font-size: 0.8rem;
        color: #6b7280;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1.5rem;
        color: #9ca3af;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    @@media (max-width: 768px) {
        .details-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .details-header-content h1 {
            font-size: 1.5rem;
        }

        .table-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .details-table {
            font-size: 0.8rem;
        }

        .details-table thead th,
        .details-table tbody td {
            padding: 0.75rem 0.5rem;
        }

        .priority-badge,
        .status-badge {
            padding: 0.25rem 0.5rem;
            font-size: 0.65rem;
        }
    }
</style>

<div class="details-container">
    <div class="container-fluid">
        <!-- Header -->
        <div class="details-header">
            <div class="details-header-content">
                <h1>
                    <i class="bi bi-ticket-detailed"></i> Service Requests
                </h1>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Employee"))
            {
                <a href="@Url.Action("Create", "ServiceRequests")" class="btn btn-success new-request-btn">
                    <i class="bi bi-plus-circle"></i> New Request
                </a>
            }
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Results Table -->
        <div class="details-table-card">
            <div class="table-header">
                <div>
                    <i class="bi bi-table"></i> Service Requests
                </div>
                <div class="result-count">
                    Showing @(Model.Count > 0 ? ((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1) : 0) to @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + Model.Count) of @ViewBag.TotalCount results
                </div>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table details-table mb-0">
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Title</th>
                                <th>Requestor</th>
                                <th>Category</th>
                                <th style="text-align: center;">Priority</th>
                                <th style="text-align: center;">Status</th>
                                <th>Technician</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                var daysOpen = (int)(DateTime.Now - request.CreatedAt).TotalDays;
                                <tr>
                                    <!-- Request Number -->
                                    <td>
                                        <a href="@Url.Action("Details", "ServiceRequests", new { id = request.RequestId })" 
                                           class="request-link">
                                            @request.RequestNumber
                                        </a>
                                    </td>

                                    <!-- Title -->
                                    <td>
                                        <div>@request.Title</div>
                                        <div class="small-text">@request.Description.Substring(0, Math.Min(50, request.Description.Length))@(request.Description.Length > 50 ? "..." : "")</div>
                                    </td>

                                    <!-- Requestor -->
                                    <td>
                                        <div>@request.Requestor?.FullName</div>
                                        <div class="small-text">@request.Requestor?.Email</div>
                                    </td>

                                    <!-- Category -->
                                    <td>@request.Category?.CategoryName</td>

                                    <!-- Priority -->
                                    <td style="text-align: center;">
                                        @{
                                            string priorityClass = "priority-medium";
                                            if (request.Priority == ITSMS.Models.ServiceRequestPriority.Low) priorityClass = "priority-low";
                                            else if (request.Priority == ITSMS.Models.ServiceRequestPriority.High) priorityClass = "priority-high";
                                            else if (request.Priority == ITSMS.Models.ServiceRequestPriority.Critical) priorityClass = "priority-critical";
                                        }
                                        <span class="priority-badge @priorityClass">@request.Priority</span>
                                    </td>

                                    <!-- Status -->
                                    <td style="text-align: center;">
                                        @{
                                            string statusClass = "status-pending";
                                            if (request.Status == ITSMS.Models.ServiceRequestStatus.Pending) statusClass = "status-pending";
                                            else if (request.Status == ITSMS.Models.ServiceRequestStatus.InProgress) statusClass = "status-inprogress";
                                            else if (request.Status == ITSMS.Models.ServiceRequestStatus.Resolved) statusClass = "status-resolved";
                                            else if (request.Status == ITSMS.Models.ServiceRequestStatus.Closed) statusClass = "status-closed";
                                        }
                                        <span class="status-badge @statusClass">@request.Status</span>
                                    </td>

                                    <!-- Technician -->
                                    <td>
                                        @if (request.AssignedTechnician != null)
                                        {
                                            @request.AssignedTechnician.FullName
                                        }
                                        else
                                        {
                                            <span class="text-muted">Unassigned</span>
                                        }
                                    </td>

                                    <!-- Created Date -->
                                    <td>
                                        <div>@request.CreatedAt.ToString("MM/dd/yyyy")</div>
                                        <div class="small-text">@request.CreatedAt.ToString("hh:mm tt")</div>
                                    </td>

                                    <!-- Actions -->
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="@Url.Action("Details", "ServiceRequests", new { id = request.RequestId })" 
                                               class="btn btn-outline-primary" title="View Details">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            @if (User.IsInRole("Technician") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                            {
                                                <a href="@Url.Action("Edit", "ServiceRequests", new { id = request.RequestId })" 
                                                   class="btn btn-outline-warning" title="Edit">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                @if (ViewBag.TotalPages > 1)
                {
                    <div style="padding: 1.5rem; background: #f9fafb; border-top: 1px solid #e5e7eb; display: flex; justify-content: center; gap: 0.5rem;">
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0" style="gap: 0.25rem;">
                                <!-- Previous Button -->
                                <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                                    @if (ViewBag.CurrentPage > 1)
                                    {
                                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })" 
                                           style="color: #667eea; border-color: #e5e7eb;">
                                            <i class="bi bi-chevron-left"></i> Previous
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="page-link" style="color: #d1d5db; border-color: #e5e7eb;">
                                            <i class="bi bi-chevron-left"></i> Previous
                                        </span>
                                    }
                                </li>

                                <!-- Page Numbers -->
                                @{
                                    int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                                    int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);

                                    if (startPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { page = 1 })" 
                                               style="color: #667eea; border-color: #e5e7eb;">1</a>
                                        </li>
                                        if (startPage > 2)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link" style="border-color: #e5e7eb;">...</span>
                                            </li>
                                        }
                                    }

                                    for (int i = startPage; i <= endPage; i++)
                                    {
                                        if (i == ViewBag.CurrentPage)
                                        {
                                            <li class="page-item active">
                                                <span class="page-link" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-color: #667eea;">
                                                    @i
                                                </span>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("Index", new { page = i })" 
                                                   style="color: #667eea; border-color: #e5e7eb;">@i</a>
                                            </li>
                                        }
                                    }

                                    if (endPage < ViewBag.TotalPages)
                                    {
                                        if (endPage < ViewBag.TotalPages - 1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link" style="border-color: #e5e7eb;">...</span>
                                            </li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.TotalPages })" 
                                               style="color: #667eea; border-color: #e5e7eb;">@ViewBag.TotalPages</a>
                                        </li>
                                    }
                                }

                                <!-- Next Button -->
                                <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                    {
                                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })" 
                                           style="color: #667eea; border-color: #e5e7eb;">
                                            Next <i class="bi bi-chevron-right"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="page-link" style="color: #d1d5db; border-color: #e5e7eb;">
                                            Next <i class="bi bi-chevron-right"></i>
                                        </span>
                                    }
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>No service requests found.</p>
                </div>
            }
        </div>
    </div>
</div>
