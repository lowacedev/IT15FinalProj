@model ITSMS.Models.ServiceRequest

@{
    ViewData["Title"] = "Create Service Request";
    var categories = ViewData["Categories"] as List<ITSMS.Models.Category>;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h3>Create New Service Request</h3>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Create">
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
                        {
                            <div class="alert alert-danger" role="alert">
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    @foreach (var error in modelState.Errors)
                                    {
                                        <p>@error.ErrorMessage</p>
                                    }
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label for="title" class="form-label">Title *</label>
                            <input type="text" id="title" name="Title" class="form-control" 
                                   required maxlength="150" placeholder="Brief title of your request" />
                            <small class="form-text text-muted">Maximum 150 characters</small>
                        </div>

                        <div class="mb-3">
                            <label for="categoryId" class="form-label">Category *</label>
                            <select id="categoryId" name="CategoryId" class="form-select" required>
                                <option value="">-- Select a category --</option>
                                @if (categories != null)
                                {
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.CategoryId">@category.CategoryName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description *</label>
                            <textarea id="description" name="Description" class="form-control" 
                                      rows="6" required placeholder="Provide detailed description of your issue..."></textarea>
                            <small class="form-text text-muted">Minimum 10 characters</small>
                        </div>

                        <div class="mb-3">
                            <label for="priority" class="form-label">Priority (Optional)</label>
                            <select id="priority" name="Priority" class="form-select">
                                <option value="1">Low</option>
                                <option value="2" selected>Medium</option>
                                <option value="3">High</option>
                                <option value="4">Critical</option>
                            </select>
                        </div>

                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                            <a href="@Url.Action("Index", "ServiceRequests")" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success">Submit Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
