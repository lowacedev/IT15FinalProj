@model IEnumerable<ITSMS.Models.TicketComment>

<div id="comment-thread" class="mt-4">
    @if (Model != null && Model.Any())
    {
        foreach (var comment in Model)
        {
            var isInternal = comment.IsInternal;
            
            if (isInternal && !(User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Technician")))
            {
                continue; // Do not render internal notes for regular employees/clients
            }

            var cardClass = isInternal ? "card mb-3 bg-warning bg-opacity-10" : "card mb-3";

            <div class="@cardClass">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="card-subtitle text-muted">
                            <i class="bi bi-person-circle me-1"></i> @(comment.Author?.FullName ?? "Unknown User")
                        </h6>
                        <small class="text-muted">
                            @if (isInternal)
                            {
                                <span class="badge bg-warning text-dark me-2">Internal note</span>
                            }
                            <i class="bi bi-clock me-1"></i> @comment.CreatedAt.ToString("MMM dd, hh:mm tt")
                        </small>
                    </div>
                    <p class="card-text">@Html.Raw(comment.Body.Replace("\n", "<br>"))</p>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-muted fst-italic" id="no-comments-msg">No comments yet.</p>
    }
</div>
