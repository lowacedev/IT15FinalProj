@model IEnumerable<ITSMS.Models.AuditLog>

@{
    ViewData["Title"] = "System Audit Logs";
}

<style>
    .details-container {
        background: #f8f9fa;
        min-height: 100vh;
        padding-bottom: 2rem;
    }

    .details-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .details-header-content h1 {
        font-weight: 700;
        margin-bottom: 0;
        font-size: 2rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .details-table-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .table-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1.25rem 1.5rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .result-count {
        font-size: 0.875rem;
        opacity: 0.9;
    }

    .details-table {
        margin-bottom: 0;
        font-size: 0.9rem;
    }

    .details-table thead {
        background: #f3f4f6;
        border-bottom: 2px solid #e5e7eb;
    }

    .details-table thead th {
        font-weight: 600;
        color: #374151;
        padding: 1rem;
        border: none;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .details-table tbody tr {
        border-bottom: 1px solid #e5e7eb;
        transition: all 0.3s ease;
    }

    .details-table tbody tr:hover {
        background: #f9fafb;
    }

    .details-table tbody td {
        padding: 1rem;
        vertical-align: middle;
    }

    .action-badge {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    .action-create { color: #166534; }
    .action-update { color: #1e40af; }
    .action-delete { color: #991b1b; }
    .action-assign { color: #92400e; }
    .action-default { color: #374151; }

    .module-badge {
        display: inline-block;
        padding: 0.375rem 0.75rem;
        border-radius: 4px;
        font-weight: 600;
        font-size: 0.75rem;
        color: #374151;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1.5rem;
        color: #9ca3af;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .filter-section {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
</style>

<div class="details-container">
    <div class="container-fluid">
        <!-- Header -->
        <div class="details-header">
            <div class="details-header-content">
                <h1>
                    <i class="bi bi-shield-lock"></i> System Audit Logs
                </h1>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="moduleFilter" class="form-label text-muted small fw-bold">FILTER BY MODULE</label>
                    <select name="moduleFilter" id="moduleFilter" class="form-select" asp-items="ViewBag.Modules">
                        <option value="">All Modules</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="actionFilter" class="form-label text-muted small fw-bold">FILTER BY ACTION</label>
                    <select name="actionFilter" id="actionFilter" class="form-select" asp-items="ViewBag.Actions">
                        <option value="">All Actions</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                    <a href="@Url.Action("Index", "AuditLog")" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Clear
                    </a>
                </div>
            </form>
        </div>

        <!-- Results Table -->
        <div class="details-table-card">
            <div class="table-header">
                <div>
                    <i class="bi bi-table"></i> Activity Logs
                </div>
                <div class="result-count">
                    Showing @(Model.Any() ? ((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1) : 0) to @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + Model.Count()) of @ViewBag.TotalCount results
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>No audit logs found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table details-table mb-0">
                        <thead>
                            <tr>
                                <th>Date & Time</th>
                                <th>User</th>
                                <th>Action</th>
                                <th>Module</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@log.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@log.CreatedAt.ToString("hh:mm:ss tt")</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@(log.User?.FullName ?? $"User ID: {log.UserId}")</div>
                                        <small class="text-muted">@(log.User?.Email)</small>
                                    </td>
                                    <td>
                                        @{
                                            string actionClass = log.Action switch
                                            {
                                                "CREATE" => "action-create",
                                                "UPDATE" => "action-update",
                                                "DELETE" => "action-delete",
                                                "ASSIGN" => "action-assign",
                                                _ => "action-default"
                                            };
                                        }
                                        <span class="action-badge @actionClass">@log.Action</span>
                                    </td>
                                    <td>
                                        <span class="module-badge">@log.Module</span>
                                    </td>
                                    <td>
                                        @log.Description
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                @if (ViewBag.TotalPages > 1)
                {
                    <div style="padding: 1.5rem; background: #f9fafb; border-top: 1px solid #e5e7eb; display: flex; justify-content: center; gap: 0.5rem;">
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0" style="gap: 0.25rem;">
                                <!-- Previous Button -->
                                <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                                    @if (ViewBag.CurrentPage > 1)
                                    {
                                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, moduleFilter = ViewBag.SelectedModule, actionFilter = ViewBag.SelectedAction })" 
                                           style="color: #667eea; border-color: #e5e7eb;">
                                            <i class="bi bi-chevron-left"></i> Previous
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="page-link" style="color: #d1d5db; border-color: #e5e7eb;">
                                            <i class="bi bi-chevron-left"></i> Previous
                                        </span>
                                    }
                                </li>

                                <!-- Page Numbers -->
                                @{
                                    int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                                    int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);

                                    if (startPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { page = 1, moduleFilter = ViewBag.SelectedModule, actionFilter = ViewBag.SelectedAction })" 
                                               style="color: #667eea; border-color: #e5e7eb;">1</a>
                                        </li>
                                        if (startPage > 2)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link" style="border-color: #e5e7eb;">...</span>
                                            </li>
                                        }
                                    }

                                    for (int i = startPage; i <= endPage; i++)
                                    {
                                        if (i == ViewBag.CurrentPage)
                                        {
                                            <li class="page-item active">
                                                <span class="page-link" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-color: #667eea;">
                                                    @i
                                                </span>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("Index", new { page = i, moduleFilter = ViewBag.SelectedModule, actionFilter = ViewBag.SelectedAction })" 
                                                   style="color: #667eea; border-color: #e5e7eb;">@i</a>
                                            </li>
                                        }
                                    }

                                    if (endPage < ViewBag.TotalPages)
                                    {
                                        if (endPage < ViewBag.TotalPages - 1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link" style="border-color: #e5e7eb;">...</span>
                                            </li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.TotalPages, moduleFilter = ViewBag.SelectedModule, actionFilter = ViewBag.SelectedAction })" 
                                               style="color: #667eea; border-color: #e5e7eb;">@ViewBag.TotalPages</a>
                                        </li>
                                    }
                                }

                                <!-- Next Button -->
                                <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                    {
                                        <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, moduleFilter = ViewBag.SelectedModule, actionFilter = ViewBag.SelectedAction })" 
                                           style="color: #667eea; border-color: #e5e7eb;">
                                            Next <i class="bi bi-chevron-right"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="page-link" style="color: #d1d5db; border-color: #e5e7eb;">
                                            Next <i class="bi bi-chevron-right"></i>
                                        </span>
                                    }
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>
