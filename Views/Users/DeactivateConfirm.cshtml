@model ITSMS.Models.User

@{
    ViewData["Title"] = "Confirm Deactivation";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Confirm User Deactivation</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Warning!</strong> You are about to deactivate this user account.
                    </div>

                    <p class="mb-3">
                        This action will deactivate the user account for:
                    </p>

                    <div class="card mb-3">
                        <div class="card-body">
                            <p class="mb-1"><strong>Name:</strong> @Model.FullName</p>
                            <p class="mb-1"><strong>Username:</strong> @Model.Username</p>
                            <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
                            <p class="mb-0"><strong>Role:</strong> <span class="badge bg-info">@Model.Role?.RoleName</span></p>
                        </div>
                    </div>

                    <p class="text-muted mb-3">
                        The user will not be able to log in or access the system after deactivation.
                        This action can be reversed by an administrator.
                    </p>

                    <form method="post" asp-action="Deactivate" asp-route-id="@Model.UserId">
                        <div class="d-grid gap-2 d-md-block">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-lock"></i> Deactivate User
                            </button>
                            <a href="@Url.Action("Details", "Users", new { id = Model.UserId })" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
