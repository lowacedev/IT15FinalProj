@model ITSMS.Models.Asset

@{
    ViewData["Title"] = "Asset Details";
    var currentAssignment = Model.Assignments?.FirstOrDefault(a => a.ReturnedDate == null);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Asset Details</h2>
    <div>
        @if (currentAssignment == null && Model.Status == ITSMS.Models.AssetStatus.Working)
        {
            <a asp-action="Assign" asp-route-id="@Model?.Id" class="btn btn-success me-2">
                <i class="bi bi-person-plus"></i> Assign Asset
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary me-2">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-5">
        <!-- Asset Info Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>General Information</h5>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <span class="badge bg-dark fs-5 mb-2">@Model.AssetTag</span>
                    <h4 class="fw-bold">@Model.AssetName</h4>
                    <span class="text-muted">Category: @Model.Category</span>
                </div>
                
                <hr />
                
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small text-uppercase">Status</dt>
                    <dd class="col-sm-7 mb-3">
                        @if (Model.Status == ITSMS.Models.AssetStatus.Working)
                        {
                            <span class="badge bg-success">Working</span>
                        }
                        else if (Model.Status == ITSMS.Models.AssetStatus.Defective)
                        {
                            <span class="badge bg-danger">Defective</span>
                        }
                        else if (Model.Status == ITSMS.Models.AssetStatus.UnderRepair)
                        {
                            <span class="badge bg-warning text-dark">Under Repair</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Retired</span>
                        }
                    </dd>

                    <dt class="col-sm-5 text-muted small text-uppercase">Purchase Date</dt>
                    <dd class="col-sm-7 mb-3">@(Model.PurchaseDate?.ToShortDateString() ?? "N/A")</dd>
                    
                    <dt class="col-sm-5 text-muted small text-uppercase">Warranty Expiry</dt>
                    <dd class="col-sm-7 mb-0">@(Model.WarrantyExpiry?.ToShortDateString() ?? "N/A")</dd>
                </dl>
            </div>
        </div>
        
        <!-- Current Assignment -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-badge text-primary me-2"></i>Current Assignment</h5>
            </div>
            <div class="card-body text-center">
                @if (currentAssignment != null)
                {
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-fill text-secondary fs-2"></i>
                    </div>
                    <h5 class="fw-bold">@currentAssignment.Employee?.User?.FullName</h5>
                    <p class="text-muted small">Assigned on @currentAssignment.AssignedDate.ToShortDateString()</p>
                    
                    <form asp-action="Return" asp-route-id="@currentAssignment.Id" method="post" class="mt-3">
                        <button type="submit" class="btn btn-outline-warning" onclick="return confirm('Are you sure you want to mark this asset as returned?');">
                            <i class="bi bi-arrow-return-left"></i> Mark as Returned
                        </button>
                    </form>
                }
                else
                {
                    <i class="bi bi-person-x fs-1 text-muted d-block mb-3 mt-2"></i>
                    <p class="text-muted">Not currently assigned to anyone.</p>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-7">
        <!-- Assignment History -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history text-primary me-2"></i>Assignment History</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Employee</th>
                                <th>Assigned</th>
                                <th>Returned</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Assignments != null && Model.Assignments.Any())
                            {
                                foreach (var assignment in Model.Assignments.OrderByDescending(a => a.AssignedDate))
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Employees" asp-action="Details" asp-route-id="@assignment.EmployeeId" class="text-decoration-none">
                                                @assignment.Employee?.User?.FullName
                                            </a>
                                        </td>
                                        <td>@assignment.AssignedDate.ToShortDateString()</td>
                                        <td>
                                            @if (assignment.ReturnedDate.HasValue)
                                            {
                                                @assignment.ReturnedDate.Value.ToShortDateString()
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">Current</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-3">No history available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- Service Requests -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-tools text-primary me-2"></i>Related Service Requests</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>REQ #</th>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ServiceRequests != null && Model.ServiceRequests.Any())
                            {
                                foreach (var req in Model.ServiceRequests.OrderByDescending(r => r.CreatedAt))
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@req.RequestId" class="text-decoration-none fw-bold">
                                                @req.RequestNumber
                                            </a>
                                        </td>
                                        <td>@req.Title</td>
                                        <td>
                                            @if (req.Status == ITSMS.Models.ServiceRequestStatus.Pending) { <span class="badge bg-warning text-dark">Pending</span> }
                                            else if (req.Status == ITSMS.Models.ServiceRequestStatus.InProgress) { <span class="badge bg-primary">In Progress</span> }
                                            else if (req.Status == ITSMS.Models.ServiceRequestStatus.Resolved) { <span class="badge bg-success">Resolved</span> }
                                            else if (req.Status == ITSMS.Models.ServiceRequestStatus.Closed) { <span class="badge bg-secondary">Closed</span> }
                                        </td>
                                        <td>@req.CreatedAt.ToShortDateString()</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No service requests linked to this asset.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
