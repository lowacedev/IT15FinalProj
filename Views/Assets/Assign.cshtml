@model ITSMS.Models.AssetAssignment

@{
    ViewData["Title"] = "Assign Asset";
    var asset = ViewBag.Asset as ITSMS.Models.Asset;
}

<div class="mb-4">
    <h2>Assign Asset</h2>
    <p class="text-muted">Assign <span class="badge bg-dark">@asset?.AssetTag</span> to an employee.</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-link text-primary me-2"></i>Assignment Details</h5>
            </div>
            <div class="card-body p-4">
                
                <div class="mb-4 p-3 bg-light rounded border">
                    <h5 class="fw-bold mb-1">@asset?.AssetName</h5>
                    <div class="text-muted small">
                        <span class="me-3"><i class="bi bi-tag"></i> @asset?.Category</span>
                        <span><i class="bi bi-check-circle"></i> @asset?.Status</span>
                    </div>
                </div>

                <form asp-action="Assign">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="AssetId" />
                    
                    <div class="mb-3">
                        <label asp-for="EmployeeId" class="form-label fw-bold">Select Employee</label>
                        <select asp-for="EmployeeId" class="form-select form-select-lg" asp-items="ViewBag.EmployeeId">
                            <option value="">Choose an active employee</option>
                        </select>
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AssignedDate" class="form-label fw-bold"></label>
                        <input asp-for="AssignedDate" class="form-control" type="date" />
                        <span asp-validation-for="AssignedDate" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Details" asp-route-id="@asset?.Id" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle"></i> Complete Assignment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
