@model ReportsViewModel

@{
    ViewData["Title"] = "Technician Performance";
}

<style>
    .performance-container {
        background: #f8f9fa;
        min-height: 100vh;
        padding-bottom: 2rem;
    }

    .performance-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .performance-header h1 {
        font-weight: 700;
        margin-bottom: 0.5rem;
        font-size: 2.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .performance-header p {
        opacity: 0.95;
        margin: 0;
    }

    .summary-card {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        text-align: right;
        border-top: 4px solid #667eea;
        margin-bottom: 1.5rem;
    }

    .summary-card h6 {
        color: #6b7280;
        font-size: 0.875rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .summary-card .value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #1f2937;
    }

    .performance-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1.25rem 1.5rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .card-header-custom i {
        font-size: 1.25rem;
    }

    .card-body-custom {
        padding: 0;
    }

    .performance-table {
        margin-bottom: 0;
        font-size: 0.95rem;
    }

    .performance-table thead {
        background: #f3f4f6;
        border-bottom: 2px solid #e5e7eb;
    }

    .performance-table thead th {
        font-weight: 600;
        color: #374151;
        padding: 1rem;
        border: none;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }

    .performance-table tbody tr {
        border-bottom: 1px solid #e5e7eb;
        transition: all 0.3s ease;
    }

    .performance-table tbody tr:hover {
        background: #f9fafb;
    }

    .performance-table tbody td {
        padding: 1rem;
        vertical-align: middle;
    }

    .technician-name {
        font-weight: 600;
        color: #1f2937;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .tech-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.875rem;
    }

    .status-active {
        color: #10b981;
        font-weight: 600;
    }

    .status-inactive {
        color: #ef4444;
        font-weight: 600;
    }

    .stat-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        font-weight: 600;
        font-size: 0.875rem;
        color: #0369a1;
    }

    .stat-badge.pending {
        color: #92400e;
    }

    .stat-badge.in-progress {
        color: #92400e;
    }

    .stat-badge.completed {
        color: #166534;
    }

    .progress-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .progress-bar-custom {
        flex: 1;
        height: 20px;
        background: #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #667eea, #764ba2);
        border-radius: 10px;
        transition: width 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .progress-percentage {
        min-width: 45px;
        text-align: right;
        font-weight: 600;
        color: #1f2937;
    }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: #9ca3af;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .last-active {
        font-size: 0.875rem;
        color: #6b7280;
    }

    @@media (max-width: 768px) {
        .performance-header h1 {
            font-size: 1.75rem;
        }

        .performance-table {
            font-size: 0.85rem;
        }

        .performance-table thead th,
        .performance-table tbody td {
            padding: 0.75rem 0.5rem;
        }

        .stat-badge {
            min-width: 32px;
            height: 32px;
            font-size: 0.75rem;
        }

        .progress-percentage {
            min-width: 35px;
            font-size: 0.85rem;
        }
    }
</style>

<div class="performance-container">
    <div class="container-fluid">
        <!-- Header -->
        <div class="performance-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1>
                    <i class="bi bi-people-fill"></i> Technician Performance
                </h1>
                <p>Track individual technician workload, completed tickets, and performance metrics</p>
            </div>
            <div>
                <a href="@Url.Action("ExportTechnicianPerformancePdf", "Reports")" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-pill shadow-sm" target="_blank">
                    <i class="bi bi-file-earmark-pdf-fill me-2"></i> Export PDF
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Summary Row -->
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="summary-card">
                    <h6>Total Requests</h6>
                    <div class="value">@Model.TotalRequests</div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="summary-card" style="border-top-color: #10b981;">
                    <h6>Resolved Tickets</h6>
                    <div class="value" style="color: #10b981;">@Model.ResolvedRequests</div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="summary-card" style="border-top-color: #f97316;">
                    <h6>In Progress</h6>
                    <div class="value" style="color: #f97316;">@Model.InProgressRequests</div>
                </div>
            </div>
        </div>

        <!-- Technician Performance Table -->
        <div class="performance-card">
            <div class="card-header-custom">
                <i class="bi bi-table"></i> Technician Workload & Performance
            </div>
            <div class="card-body-custom">
                @if (Model.TechnicianPerformances != null && Model.TechnicianPerformances.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table performance-table mb-0">
                            <thead>
                                <tr>
                                    <th>Technician</th>
                                    <th style="text-align: center;">Assigned</th>
                                    <th style="text-align: center;">Completed</th>
                                    <th style="text-align: center;">In Progress</th>
                                    <th style="text-align: center;">Pending</th>
                                    <th>Completion Rate</th>
                                    <th>Last Active</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tech in Model.TechnicianPerformances)
                                {
                                    <tr>
                                        <!-- Technician Name with Avatar -->
                                        <td>
                                            <div class="technician-name">
                                                <div class="tech-avatar">
                                                    @tech.TechnicianName.Substring(0, 1).ToUpper()
                                                </div>
                                                <span>@tech.TechnicianName</span>
                                            </div>
                                        </td>

                                        <!-- Assigned Tickets -->
                                        <td style="text-align: center;">
                                            <span class="stat-badge">
                                                @tech.AssignedTickets
                                            </span>
                                        </td>

                                        <!-- Completed Tickets -->
                                        <td style="text-align: center;">
                                            <span class="stat-badge completed">
                                                @tech.CompletedTickets
                                            </span>
                                        </td>

                                        <!-- In Progress Tickets -->
                                        <td style="text-align: center;">
                                            <span class="stat-badge in-progress">
                                                @tech.InProgressTickets
                                            </span>
                                        </td>

                                        <!-- Pending Tickets -->
                                        <td style="text-align: center;">
                                            <span class="stat-badge pending">
                                                @tech.PendingTickets
                                            </span>
                                        </td>

                                        <!-- Completion Rate with Progress Bar -->
                                        <td>
                                            <div class="progress-container">
                                                <div class="progress-bar-custom">
                                                    <div class="progress-fill" style="width: @(Math.Min(tech.CompletionRate, 100))%;">
                                                        @if (tech.CompletionRate >= 20)
                                                        {
                                                            <span>@tech.CompletionRate%</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="progress-percentage">@tech.CompletionRate%</div>
                                            </div>
                                        </td>

                                        <!-- Last Active -->
                                        <td>
                                            <div class="last-active">
                                                @if (tech.LastActive > DateTime.Now.AddDays(-7))
                                                {
                                                    <span>
                                                        @if (tech.LastActive.Date == DateTime.Now.Date)
                                                        {
                                                            <span>Today</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@tech.LastActive.ToString("MM/dd")</span>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span style="color: #9ca3af;">Inactive</span>
                                                }
                                            </div>
                                        </td>

                                        <!-- Status -->
                                        <td>
                                            @if (tech.IsActive)
                                            {
                                                <span class="status-active">
                                                    <i class="bi bi-check-circle-fill"></i> Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-inactive">
                                                    <i class="bi bi-x-circle-fill"></i> Inactive
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>No technicians found in the system.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Back Button -->
        <div class="mt-4">
            <a href="@Url.Action("Analytics", "Reports")" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left"></i> Back to Analytics
            </a>
        </div>
    </div>
</div>
