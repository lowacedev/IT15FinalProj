@model ITSMS.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Employee Details</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit Employee
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <!-- Employee Info Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-badge text-primary me-2"></i>Profile</h5>
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-person-fill text-secondary fs-1"></i>
                    </div>
                    <h4 class="mt-3 mb-1">@Model.User?.FullName</h4>
                    <p class="text-muted mb-2">@Model.Position</p>
                    @if (Model.Status == ITSMS.Models.EmployeeStatus.Active)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>
                
                <hr />
                
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small text-uppercase">Code</dt>
                    <dd class="col-sm-8 mb-3"><span class="badge bg-dark">@Model.EmployeeCode</span></dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Email</dt>
                    <dd class="col-sm-8 mb-3"><a href="mailto:@Model.User?.Email">@Model.User?.Email</a></dd>

                    <dt class="col-sm-4 text-muted small text-uppercase">Department</dt>
                    <dd class="col-sm-8 mb-3"><span class="badge bg-info text-dark">@Model.Department?.Name</span></dd>
                </dl>
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <!-- Assets Assigned Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-laptop text-primary me-2"></i>Assigned Assets</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Asset Tag</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Assigned Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AssetAssignments != null && Model.AssetAssignments.Any(a => a.ReturnedDate == null))
                            {
                                foreach (var assignment in Model.AssetAssignments.Where(a => a.ReturnedDate == null))
                                {
                                    <tr>
                                        <td><span class="fw-bold">@assignment.Asset?.AssetTag</span></td>
                                        <td>@assignment.Asset?.AssetName</td>
                                        <td>@assignment.Asset?.Category</td>
                                        <td>
                                            @if (assignment.Asset?.Status == ITSMS.Models.AssetStatus.Working)
                                            {
                                                <span class="badge bg-success">Working</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">@assignment.Asset?.Status</span>
                                            }
                                        </td>
                                        <td>@assignment.AssignedDate.ToShortDateString()</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="bi bi-box fs-3 d-block mb-2"></i>
                                        No active assets assigned.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
