@model ITSMS.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="mb-4">
    <h2>Edit Employee</h2>
    <p class="text-muted">Update employee details for @Model.User?.FullName.</p>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UserId" />
                    
                    <!-- User Info (Read-only) -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Linked User</label>
                            <input type="text" class="form-control" value="@Model.User?.FullName" disabled />
                            <small class="form-text text-muted">@Model.User?.Email</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmployeeCode" class="form-label fw-bold"></label>
                            <input asp-for="EmployeeCode" class="form-control" />
                            <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="EmployeeNumber" class="form-label fw-bold"></label>
                            <input asp-for="EmployeeNumber" class="form-control" placeholder="e.g. EMP-2023-001" />
                            <span asp-validation-for="EmployeeNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HireDate" class="form-label fw-bold"></label>
                            <input asp-for="HireDate" class="form-control" type="date" />
                            <span asp-validation-for="HireDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="DepartmentId" class="form-label fw-bold"></label>
                            <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId"></select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Position" class="form-label fw-bold"></label>
                            <input asp-for="Position" class="form-control" />
                            <span asp-validation-for="Position" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-bold"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ITSMS.Models.EmployeeStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="EmploymentStatus" class="form-label fw-bold"></label>
                            <select asp-for="EmploymentStatus" class="form-select">
                                <option value="">Select Status</option>
                                <option value="Full-Time">Full-Time</option>
                                <option value="Part-Time">Part-Time</option>
                                <option value="Contract">Contract</option>
                            </select>
                            <span asp-validation-for="EmploymentStatus" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SalaryRate" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text">₱</span>
                                <input asp-for="SalaryRate" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="SalaryRate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between border-top pt-3 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
