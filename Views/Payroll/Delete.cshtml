@model ITSMS.Models.Payroll

@{
    ViewData["Title"] = "Delete Payroll";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Payroll Record</h2>
    <div class="alert alert-warning">
        <strong>Warning!</strong> Are you sure you want to delete this payroll record? This action cannot be undone.
    </div>
    
    <div class="card shadow-sm col-md-8 border-danger">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Employee</dt>
                <dd class="col-sm-8">@Model.Employee?.User?.FirstName @Model.Employee?.User?.LastName</dd>
                
                <dt class="col-sm-4">Payroll Month</dt>
                <dd class="col-sm-8">@Model.PayrollMonth</dd>
                
                <dt class="col-sm-4">Net Salary</dt>
                <dd class="col-sm-8 fw-bold">@Model.NetSalary.ToString("C")</dd>
                
                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.PayrollStatus</dd>
            </dl>
            
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete Record</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
