@model ITSMS.Models.Payroll

@{
    ViewData["Title"] = "Generate Payroll";
}

<div class="container mt-4">
    <h2>Generate Payroll</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="EmployeeId" class="form-label fw-bold">Employee</label>
                            <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.EmployeeId" id="EmployeeId">
                                <option value=""> Select Employee </option>
                            </select>
                            <span asp-validation-for="EmployeeId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="PayrollMonth" class="form-label fw-bold">Payroll Month</label>
                            <input asp-for="PayrollMonth" class="form-control" type="month" />
                            <span asp-validation-for="PayrollMonth" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="BasicSalary" class="form-label fw-bold">Basic Salary</label>
                            <div class="input-group">
                                <span class="input-group-text">₱</span>
                                <input asp-for="BasicSalary" class="form-control salary-input" type="number" step="0.01" id="BasicSalary" />
                            </div>
                            <span asp-validation-for="BasicSalary" class="text-danger"></span>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Allowance" class="form-label fw-bold">Allowance</label>
                                <div class="input-group">
                                    <span class="input-group-text">₱</span>
                                    <input asp-for="Allowance" class="form-control salary-input" type="number" step="0.01" value="0.00" id="Allowance" />
                                </div>
                                <span asp-validation-for="Allowance" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OvertimePay" class="form-label fw-bold">Overtime Pay</label>
                                <div class="input-group">
                                    <span class="input-group-text">₱</span>
                                    <input asp-for="OvertimePay" class="form-control salary-input" type="number" step="0.01" value="0.00" id="OvertimePay" />
                                </div>
                                <span asp-validation-for="OvertimePay" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Deduction" class="form-label fw-bold">Deduction</label>
                            <div class="input-group">
                                <span class="input-group-text">₱</span>
                                <input asp-for="Deduction" class="form-control salary-input text-danger" type="number" step="0.01" value="0.00" id="Deduction" />
                            </div>
                            <span asp-validation-for="Deduction" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Net Salary (Auto-computed)</label>
                            <div class="input-group">
                                <span class="input-group-text fw-bold text-success">₱</span>
                                <input class="form-control fw-bold text-success bg-light" type="text" id="NetSalary" readonly value="0.00" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PayrollStatus" class="form-label fw-bold">Status</label>
                            <select asp-for="PayrollStatus" class="form-select">
                                <option value="0">Pending</option>
                                <option value="1">Paid</option>
                            </select>
                            <span asp-validation-for="PayrollStatus" class="text-danger"></span>
                        </div>
                        
                        <div class="d-flex justify-content-between border-top pt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check-circle"></i> Generate Payroll
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const employeeSelect = document.getElementById('EmployeeId');
            const basicSalaryInput = document.getElementById('BasicSalary');
            const allowanceInput = document.getElementById('Allowance');
            const overtimePayInput = document.getElementById('OvertimePay');
            const deductionInput = document.getElementById('Deduction');
            const netSalaryInput = document.getElementById('NetSalary');

            function calculateNetSalary() {
                const basic = parseFloat(basicSalaryInput.value) || 0;
                const allowance = parseFloat(allowanceInput.value) || 0;
                const overtime = parseFloat(overtimePayInput.value) || 0;
                const deduction = parseFloat(deductionInput.value) || 0;

                const net = basic + allowance + overtime - deduction;
                netSalaryInput.value = net.toFixed(2);
            }

            employeeSelect.addEventListener('change', function () {
                const employeeId = this.value;
                if (employeeId) {
                    fetch(`/Payroll/GetSalaryRate/${employeeId}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.salaryRate !== undefined) {
                                basicSalaryInput.value = data.salaryRate.toFixed(2);
                                calculateNetSalary();
                            }
                        })
                        .catch(error => console.error('Error fetching salary rate:', error));
                } else {
                    basicSalaryInput.value = '0.00';
                    calculateNetSalary();
                }
            });

            // Recalculate on any input change
            const inputs = document.querySelectorAll('.salary-input');
            inputs.forEach(input => {
                input.addEventListener('input', calculateNetSalary);
            });
            
            // Initial calculation if editing/reloading form
            calculateNetSalary();
        });
    </script>
}
