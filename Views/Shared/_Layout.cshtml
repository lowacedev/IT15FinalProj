<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ITSMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ITSMS.styles.css" asp-append-version="true" />
    <!-- Chart.js for analytics charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Reports" asp-action="Dashboard">ITSMS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span>@User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" asp-controller="Auth" asp-action="Logout">Logout</a></li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <div class="row">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="col-md-2 d-md-block bg-light sidebar p-0" style="min-height: calc(100vh - 100px); border-right: 1px solid #e5e7eb;">
                    <div class="sidebar-sticky p-3">
                        <style>
                            .sidebar-nav {
                                list-style: none;
                                padding: 0;
                            }
                            .sidebar-nav .nav-item {
                                margin-bottom: 0.5rem;
                            }
                            .sidebar-nav .nav-link {
                                color: #374151;
                                padding: 0.75rem 1rem;
                                border-radius: 6px;
                                display: flex;
                                align-items: center;
                                gap: 0.75rem;
                                transition: all 0.2s ease;
                                font-weight: 500;
                                font-size: 0.95rem;
                            }
                            .sidebar-nav .nav-link:hover {
                                background-color: #f3f4f6;
                                color: #667eea;
                                transform: translateX(2px);
                            }
                            .sidebar-nav .nav-link i {
                                font-size: 1.1rem;
                                width: 20px;
                                text-align: center;
                            }
                            .sidebar-heading {
                                font-size: 0.8rem;
                                font-weight: 700;
                                color: #9ca3af !important;
                                text-transform: uppercase;
                                letter-spacing: 0.05em;
                            }
                        </style>

                        <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-3 mb-3">
                            MENU
                        </h6>
                        <ul class="nav flex-column sidebar-nav">
                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Technician"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="TechnicianDashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="ServiceRequests" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="ServiceRequests" asp-action="Index">
                                        <i class="bi bi-ticket-detailed"></i> Service Requests
                                    </a>
                                </li>
                                
                                <hr class="my-3" style="border: none; border-top: 1px solid #e5e7eb;" />
                                <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-3 mb-3">
                                    ANALYTICS
                                </h6>
                                
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="Analytics">
                                        <i class="bi bi-graph-up"></i> Analytics & Charts
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="TechnicianPerformance">
                                        <i class="bi bi-people-fill"></i> Technician Performance
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="ServiceRequestsDetails">
                                        <i class="bi bi-list-check"></i> Detailed Requests
                                    </a>
                                </li>

                            }

                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <hr class="my-3" style="border: none; border-top: 1px solid #e5e7eb;" />
                                <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-3 mb-3">
                                    ADMIN
                                </h6>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Users" asp-action="Index">
                                        <i class="bi bi-people"></i> Users Management
                                    </a>
                                </li>
                                 <li class="nav-item">
                                    <a class="nav-link" asp-controller="Employees" asp-action="Index">
                                        <i class="bi bi-person-badge"></i> Employees Management
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Assets" asp-action="Index">
                                        <i class="bi bi-pc-display"></i> Assets Management
                                    </a>
                                </li>
                            }

                         
                            @if (User.IsInRole("Technician"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="ServiceRequests" asp-action="Index">
                                        <i class="bi bi-check2-circle"></i> My Assignments
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Assignments" asp-action="Workload">
                                        <i class="bi bi-bar-chart"></i> Workload Stats
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Employee"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="ServiceRequests" asp-action="Index">
                                        <i class="bi bi-list-check"></i> My Requests
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="ServiceRequests" asp-action="Create">
                                        <i class="bi bi-plus-circle"></i> New Request
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </nav>
                <main role="main" class="col-md-9 ml-sm-auto col-lg-10 px-4 pb-3">
                    @RenderBody()
                </main>
            }
            else
            {
                <main role="main" class="pb-3 w-100">
                    @RenderBody()
                </main>
            }
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ITSMS - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
