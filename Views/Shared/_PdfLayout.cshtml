<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT-SMS</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12pt;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        
        .header {
            border-bottom: 2px solid #4e73df;
            padding-bottom: 10px;
            margin-bottom: 20px;
            text-align: center;
        }

        .header h1 {
            color: #4e73df;
            margin: 0 0 5px 0;
            font-size: 24pt;
        }

        .header h2 {
            margin: 0 0 10px 0;
            font-size: 16pt;
            color: #555;
        }

        .meta-info {
            display: flex;
            justify-content: space-between;
            font-size: 10pt;
            color: #666;
            margin-top: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        table th, table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        table th {
            background-color: #f8f9fc;
            font-weight: bold;
            color: #4e73df;
        }

        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 10pt;
            color: #777;
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }

        /* Specific utilities */
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .font-weight-bold { font-weight: bold; }
        
        /* Color helpers */
        .text-success { color: #1cc88a; }
        .text-danger { color: #e74a3b; }
        .text-warning { color: #f6c23e; }
        .text-info { color: #36b9cc; }
    </style>
</head>
<body>
    <div class="header">
        <h1>IT Service Management System (IT-SMS)</h1>
        <h2>@ViewData["Title"]</h2>
        <div class="meta-info">
            <div><strong>Generated On:</strong> @DateTime.Now.ToString("MMMM dd, yyyy HH:mm:ss")</div>
            @{
                var generatedBy = ViewData["GeneratedBy"]?.ToString() ?? "System User";
                var fullNameClaim = Context.User.FindFirst("FullName")?.Value;
                if (!string.IsNullOrEmpty(fullNameClaim))
                {
                    generatedBy = fullNameClaim.Split(' ').First();
                }
            }
            <div><strong>Generated By:</strong> @generatedBy</div>
        </div>
    </div>

    <div class="content">
        @RenderBody()
    </div>

</body>
</html>
